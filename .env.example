# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/whatsapp_business_os

# Printed by `npm run migrate` — the business this process serves
BUSINESS_ID=1

# Port for the local REST API
API_PORT=3001

# Optional. If set, every API request must send:  Authorization: Bearer <token>
# Leave blank for local dev; SET IT before exposing the API to a network.
API_TOKEN=
